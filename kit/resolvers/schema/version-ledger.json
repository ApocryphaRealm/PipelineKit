{
  "type": "array",
  "items": {
    "type": "object",
    "required": ["mod", "version", "status", "recorded"],
    "properties": {
      "mod": {"type": "string"},
      "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+"},
      "status": {"type": "string", "enum": ["working", "untested", "failed", "withdrawn", "scratch"]},
      "evidence": {"type": "string"},
      "sha256": {"type": ["string", "null"]},
      "recorded": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
      "artifacts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["file", "sha256"],
          "properties": {
            "file": { "type": "string" },
            "sha256": { "type": "string" }
          }
        }
      },
      "prunePending": { "type": "boolean" },
      "retracted": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["at", "evidence", "was"],
          "properties": {
            "at": { "type": "string" },
            "evidence": { "type": "string" },
            "was": {
              "type": "object",
              "required": ["channel"],
              "properties": {
                "at": {"type": ["string", "null"]},
                "channel": {"type": "string", "enum": ["nexus", "members", "mega", "local", "modio", "unknown"]},
                "ref": {"type": ["string", "null"]},
                "file": {"type": ["string", "null"]},
                "sha256": {"type": ["string", "null"]},
                "evidence": {"type": ["string", "null"]}
              }
            }
          }
        }
      },
      "posted": {
        "type": "object",
        "required": ["channel"],
        "properties": {
          "at": {"type": ["string", "null"]},
          "channel": {"type": "string", "enum": ["nexus", "members", "mega", "local", "modio", "unknown"]},
          "ref": {"type": ["string", "null"]},
          "file": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"]},
          "evidence": {"type": ["string", "null"]}
        }
      }
    }
  }
}
